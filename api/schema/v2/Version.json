{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drod.dev/refresh/schema/v2/Version.json",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "refresh.drod.dev/v2",
      "description": "The version of the document contract."
    },
    "kind": {
      "type": "string",
      "const": "Version",
      "description": "The type of the document."
    },
    "version": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "buildDate": {
      "type": "string"
    }
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "version"
  ],
  "title": "Version",
  "description": "The document that `refresh version -o json` prints. -o yaml prints the same structure."
}
