apiVersion: refresh.drod.dev/v1
kind: NodegroupDescription
amiLookupFailure:
  awsErrorCode: s-awserrorcode
  cluster: s-cluster
  error: s-error
  kind: s-kind
  name: s-name
  operation: s-operation
  reason: s-reason
  region: s-region
  retryable: true
  updateId: s-updateid
amiStatus: Updating
amiType: s-amitype
capacityType: s-capacitytype
currentAmi: s-currentami
failures:
  - awsErrorCode: s-awserrorcode
    cluster: s-cluster
    error: s-error
    kind: s-kind
    name: s-name
    operation: s-operation
    reason: s-reason
    region: s-region
    retryable: true
    updateId: s-updateid
instanceType: s-instancetype
instances:
  - availabilityZone: s-az
    instanceId: s-instanceid
    instanceType: s-instancetype
    launchTime: "2026-01-02T03:04:05Z"
    lifecycle: s-lifecycle
    state: s-state
latestAmi: s-latestami
name: s-name
scaling:
  desiredSize: 3
  maxSize: 3
  minSize: 3
status: s-status
workloads:
  criticalPods: 3
  podDisruption: s-poddisruption
  totalPods: 3
